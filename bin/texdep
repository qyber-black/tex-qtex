my $logfile = shift;
my $file = $logfile;
my $pdffile = $logfile;
my $dep = "";

$logfile =~ s/\.tex$/\.log/;
$pdffile =~ s/\.tex$/\.pdf/;

if (! -e $logfile) {
  system ("pdflatex $file >/dev/null 2>&1; rm -f $pdffile");
}

open (FILE, "(cd .. && pwd 2>&1) |");
@LINES = <FILE>;
foreach $L (@LINES) {
  $parent_dir = $L;
}
close (FILE);

open (FILE, $logfile) || die "file $logfile not found";
@LINES = <FILE>;
close (FILE);

$D = "";
foreach $L (@LINES) {
  $L =~ s/\n//;
  $D = "$D$L";
}

@words = split (/ /, $D);
foreach $word (@words) {
  if ($word =~ /^\(/) {
    $word =~ s/^\(//;
    $word =~ s/\n//g;
    if (!($word eq $file || $word eq "./${file}" || $word =~ /.*\.aux/) && -e $word) {
      $word =~ s/^\.\.\//$parent_dir/;
      $dep = "$dep $word";
    }
  } elsif (!($word eq $file || $word eq "./${file}") && $word =~ /\</) {
    $word =~ s/^[^<]*<([^>]*)>.*$/$1/;
    $word =~ s/,.*$//;
    $word =~ s/^<//;
    $word =~ s/\n//g;
    $word =~ s/^\.\.\//$parent_dir/;
    if (-e $word) {
      $dep = "$dep $word";
    }
  }
}

print "$dep";
